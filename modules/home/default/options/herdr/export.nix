{
  config,
  lib,
  pkgs,
  ...
}: let
  cfg = config.programs.herdr;
  tomlFormat = pkgs.formats.toml {};

  # Settings any Herdr client can use. keys.command calls Nix-store scripts,
  # which a server advertises and runs itself, and ui.sound names local files.
  portable =
    cfg.settings
    // lib.optionalAttrs (cfg.settings ? keys) {keys = removeAttrs cfg.settings.keys ["command"];}
    // lib.optionalAttrs (cfg.settings ? ui) {ui = removeAttrs cfg.settings.ui ["sound"];};

  exported = pkgs.runCommand "herdr-portable.toml" {} ''
    {
      echo "# Generated by Home Manager from the NixOS flake's Herdr settings. Do not edit."
      echo "# Termux links ~/.config/herdr/config.toml to this file."
      echo
      cat ${tomlFormat.generate "herdr-portable-settings.toml" portable}
    } > $out
  '';

  # Syncthing needs portable contents, not a /nix/store symlink. The file is
  # renamed into place atomically, and only when it changed.
  exportSettings = pkgs.writeShellApplication {
    name = "export-herdr-settings";
    runtimeInputs = [pkgs.coreutils pkgs.diffutils];
    text = ''
      dest="$HOME/profile/apps/herdr/config.toml"
      mkdir -p "$(dirname "$dest")"
      if [ ! -L "$dest" ] && cmp -s ${exported} "$dest"; then
        exit 0
      fi
      tmp=$(mktemp "$dest.XXXXXX")
      cp ${exported} "$tmp"
      chmod 644 "$tmp"
      mv -fT "$tmp" "$dest"
    '';
  };
in {
  options.programs.herdr.exportSettings = lib.mkEnableOption "exporting the portable Herdr settings to the synced profile for Termux (enable on one host only)";

  # Termux reads this through ~/profile, which Syncthing carries to the phone.
  config.home.activation.exportHerdrSettings = lib.mkIf (cfg.enable && cfg.exportSettings) (
    lib.hm.dag.entryAfter ["writeBoundary"] ''
      $DRY_RUN_CMD ${lib.getExe exportSettings}
    ''
  );
}
