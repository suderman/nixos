{
  config,
  lib,
  perSystem,
  pkgs,
  ...
}: let
  cfg = config.programs.khal-org;
  state = "${config.xdg.stateHome}/khal-org";

  # Separate config and database so ISO formats and calendar names stay
  # independent of interactive khal.
  khalConfig = pkgs.writeText "khal-org.conf" (
    lib.generators.toINI {} {
      locale = {
        dateformat = "%Y-%m-%d %a";
        longdateformat = "%Y-%m-%d %a";
        timeformat = "%H:%M";
        datetimeformat = "%Y-%m-%d %a %H:%M";
        longdatetimeformat = "%Y-%m-%d %a %H:%M";
      };
      sqlite.path = "${state}/khal.db";
    }
    + "\n[calendars]\n"
    + lib.concatLines (lib.mapAttrsToList (name: path: ''
        [[${name}]]
        path = ${path}
        type = calendar
      '')
      cfg.calendars)
  );

  fields = ["start" "end" "all-day" "title" "uid" "status" "location" "organizer" "description" "repeat-pattern" "url"];

  sync = perSystem.self.mkScript {
    name = "khal-org";
    path = [config.programs.khal.package pkgs.findutils pkgs.gawk pkgs.jq pkgs.diffutils];
    text =
      # bash
      ''
        dir=${lib.escapeShellArg cfg.dir}
        mkdir -p "$dir" ${lib.escapeShellArg state}
        from="$(date -d '-30 days' '+%Y-%m-%d %a')"
        to="$(date -d '+90 days' '+%Y-%m-%d %a')"

        tmp="$(mktemp -d -p "$dir" .khal-org.XXXXXX)"
        trap 'rm -rf "$tmp"' EXIT

        while IFS=$'\t' read -r name path; do
          khal -c ${khalConfig} -v ERROR list -a "$name" --day-format "" \
            ${lib.concatMapStringsSep " " (f: "--json ${f}") fields} \
            "$from" "$to" </dev/null >"$tmp/events.json"
          find "$path" -name '*.ics' -print0 |
            xargs -0 -r awk -f ${./attendees.awk} |
            jq -Rc 'split("\t")' >"$tmp/attendees.json"
          {
            echo "#+TITLE: ''${name^} calendar (raw)"
            echo "# Generated by khal-org from $path. Edits are overwritten."
            echo "# Window: $from to $to"
            jq -nr --slurpfile att "$tmp/attendees.json" -f ${./org.jq} "$tmp/events.json"
          } >"$tmp/$name.org"
          cmp -s "$tmp/$name.org" "$dir/$name.org" || mv "$tmp/$name.org" "$dir/$name.org"
        done <<'CALENDARS'
        ${lib.concatLines (lib.mapAttrsToList (name: path: "${name}\t${path}") cfg.calendars)}CALENDARS
      '';
  };
in {
  options.programs.khal-org = {
    enable = lib.mkEnableOption "raw Org mirrors of khal calendars";

    dir = lib.mkOption {
      type = lib.types.str;
      default = "${config.home.homeDirectory}/org/calendar/raw";
      description = "Directory for the generated <name>.org files.";
    };

    calendars = lib.mkOption {
      type = lib.types.attrsOf lib.types.str;
      default = {};
      description = "Org file name mapped to the vdir collection it mirrors.";
    };
  };

  config = lib.mkIf cfg.enable {
    home.packages = [sync];

    # Refresh after each successful CalDAV sync; unchanged files are left alone.
    systemd.user.services.vdirsyncer.Unit.OnSuccess = ["khal-org.service"];
    systemd.user.services.khal-org = {
      Unit.Description = "Write khal calendars to Org";
      Service = {
        Type = "oneshot";
        ExecStart = lib.getExe sync;
      };
    };
  };
}
