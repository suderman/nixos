{
  "manifest_version": 3,
  "name": "Copy Message-ID",
  "version": "1.1.0",
  "description": "Copy each Gmail or Fastmail message's RFC Message-ID as a notmuch query.",
  "key": "",
  "permissions": ["clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/mail/*"],
      "js": ["gmail-main.js"],
      "world": "MAIN"
    },
    {
      "matches": ["https://mail.google.com/mail/*"],
      "js": ["gmail.js"],
      "css": ["gmail.css"]
    },
    {
      "matches": ["https://app.fastmail.com/*"],
      "js": ["fastmail-main.js"],
      "world": "MAIN"
    },
    {
      "matches": ["https://app.fastmail.com/*"],
      "js": ["fastmail.js"],
      "css": ["fastmail.css"]
    }
  ]
}
