{
  config,
  lib,
  ...
}: let
  cfg = config.wayland.windowManager.hyprland;
  toLua = lib.generators.toLua {};

  # Convert stylix colors to the same shape as desktop-theme palettes
  stylixColor = name: let
    c = config.lib.stylix.colors;
    r = c."${name}-rgb-r";
    g = c."${name}-rgb-g";
    b = c."${name}-rgb-b";
  in ''
    ${name} = {
      rgb = "rgb(${r},${g},${b})",
      rgba = function(alpha)
        return "rgba(${r},${g},${b}," .. tostring(alpha) .. ")"
      end,
    },
  '';
in {
  config = {
    wayland.windowManager.hyprland = {
      configType = "lua";
      extraConfig = builtins.readFile ./lua/hyprland.lua;
    };

    # lib/appearance.lua owns compositor colors
    stylix.targets.hyprland.enable = false;

    home.file =
      {
        # Recursive keeps real directories with per-file links, so
        # Home Manager can replace them without clobbering.
        ".config/hypr/lib" = {
          source = ./lua/lib;
          recursive = true;
        };
        ".config/hypr/conf" = {
          source = ./lua/conf;
          recursive = true;
        };
        ".config/hypr/binds" = {
          source = ./lua/binds;
          recursive = true;
        };
        ".config/hypr/rules" = {
          source = ./lua/rules;
          recursive = true;
        };

        ".config/hypr/generated/appearance.lua".text = "return ${toLua {
          enabled = config.programs.desktop-theme.enable;
          assets =
            if config.programs.desktop-theme.enable
            then toString config.programs.desktop-theme.assets
            else "";
          default_mode = config.programs.desktop-theme.defaultMode;
        }}";
        ".config/hypr/generated/host.lua".text = "return ${toLua {
          inherit (cfg.lua) rounding monitors env;
          exec_once = cfg.lua.execOnce;
        }}";
        # Sorted, so load order is deterministic when features share binds
        ".config/hypr/generated/feature-list.lua".text = "return ${toLua (builtins.attrNames cfg.lua.features)}";
        ".config/hypr/generated/stylix.lua".text = ''
          -- Generated by Home Manager from Stylix.
          return {
          ${lib.concatMapStrings stylixColor [
            "base00"
            "base01"
            "base02"
            "base03"
            "base04"
            "base05"
            "base06"
            "base07"
            "base08"
            "base09"
            "base0A"
            "base0B"
            "base0C"
            "base0D"
            "base0E"
            "base0F"
          ]}}
        '';
      }
      // lib.mapAttrs' (name: body:
        lib.nameValuePair ".config/hypr/features/${name}.lua" {
          text = ''
            local util = require("lib.util")
            ${body}
          '';
        })
      cfg.lua.features;

    # Local init stays writable on purpose: quick scratchpad for experiments
    # without regenerating Home Manager output.
    home.localStorePath = [
      ".config/hypr/local/init.lua"
    ];

    persist.storage.directories = [".config/hypr/local"];
    tmpfiles.files = [".config/hypr/local/init.lua"];
  };
}
